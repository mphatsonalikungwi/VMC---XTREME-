NODE_ENV=development
PORT=3000
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET
COOKIE_SECURE=false

# Owner account - create this securely before production deployment
OWNER_EMAIL=owner@example.com
OWNER_PASSWORD=CHANGE_ME

# Email (optional until configured)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Set true only when intentionally synchronizing the primary owner password from OWNER_PASSWORD.
OWNER_SYNC_PASSWORD=false
